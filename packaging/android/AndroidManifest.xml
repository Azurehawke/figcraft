<?xml version="1.0" encoding="utf-8"?>
<!-- FigCraft for Android: a NativeActivity that loads libfigcraft_android.so
     (apps/figcraft-android); its subclass FigCraftActivity (java/) keeps the latest intent,
     colours the system bars and does the updater's HTTP and install. Built by build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.storyteller.figcraft">

    <!-- The built-in file browser lists shared storage by path; granted once in Settings ▸ Apps ▸
         ⋮ ▸ Special access ▸ All files access (the browser's Allow access… button opens it). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Updates (updater.rs): the release listing and APK from GitHub, then installing it, which
         Android confirms with the user each time. Also live sessions and online files. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="FigCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:resizeableActivity="true"
        android:largeHeap="true"
        android:appCategory="productivity">

        <!-- configChanges: attaching the keyboard cover, rotating, or resizing in split screen
             must not recreate the activity (that would restart the app and its event loop). -->
        <activity
            android:name="ai.storyteller.figcraft.FigCraftActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="figcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with FigCraft (incoming.rs): SVG files, and files with no registered type,
                 which is how file managers send .figcraft and .fig documents. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
